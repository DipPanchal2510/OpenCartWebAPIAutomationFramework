{
  "compilerOptions": {
    "target": "ES2022",
    "module": "es2020",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./",
    "sourceMap": true,
    "declaration": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "pages/**/*.ts",
    "fixtures/**/*.ts",
    "utils/**/*.ts",
    "playwright.config.ts"
, "wait.spec.ts"  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "playwright-report",
    "test-results",
    "allure-results",
    "reports"
  ]
}